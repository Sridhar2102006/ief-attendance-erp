# For an API container attached to ief-network, use host postgres:5432.
DATABASE_URL=postgresql+psycopg://ief:replace_with_local_postgres_password@postgres:5432/ief_attendance

# For the API running directly on Windows, use localhost:5432 only when
# PostgreSQL's port has explicitly been published to the host.
# DATABASE_URL=postgresql+psycopg://ief:replace_with_local_postgres_password@localhost:5432/ief_attendance
